<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ZedCredentialAuditGui</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>ZedCredentialAuditGui</AssemblyName>

    <!-- Self-contained single file publish -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <OutputPath>obj\out\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

  </PropertyGroup>

  <ItemGroup>
    <!-- National flag SVGs used by the language toggle button (embedded so the
         binary works offline).  Override locally by replacing these files.
         Rendered at runtime via Svg.Skia into standard icon-sized bitmaps.
         LogicalName forces the manifest resource name regardless of project
         folder layout. -->
    <EmbeddedResource Include="Resources\tw.svg">
      <LogicalName>ZedCredentialAuditGui.Resources.tw.svg</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\us.svg">
      <LogicalName>ZedCredentialAuditGui.Resources.us.svg</LogicalName>
    </EmbeddedResource>
    <!-- App logo SVG (Font Awesome 7).  Rendered into a square icon-sized
         bitmap and assigned to Form.Icon in MainForm(). -->
    <EmbeddedResource Include="Resources\logo.svg">
      <LogicalName>ZedCredentialAuditGui.Resources.logo.svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="2.0.0.3" />
  </ItemGroup>

</Project>
